            <corners android:radius="100dp" />
            <gradient android:angle="45" android:centerColor="#BF53C9F2" android:centerX="0.1" android:endColor="#BF4A4444" android:startColor="#BF53C9F2" android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient android:angle="45" android:centerColor="@color/blue_light" android:centerX="0.1" android:endColor="@color/blue_dark" android:startColor="@color/blue_light" android:type="linear" />
        </shape>
    </item>
</selector>