<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog"
    android:orientation="vertical"
    android:padding="15dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/change_route"
        android:textColor="@color/blue_dark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/location_picker_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/input_bg"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/location_start"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:clickable="false"
            android:focusable="false"
            android:gravity="center_vertical"
            android:hint="@string/route_1"
            android:paddingHorizontal="12dp"
            android:textColor="@color/black"
            android:textColorHint="@color/gray_dark"
            android:textSize="15sp" />

        <ImageButton
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@android:color/transparent"
            android:clickable="false"
            android:contentDescription="@string/location_picker"
            android:focusable="false"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/add_location" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/location_picker_end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="10dp"
        android:background="@drawable/input_bg"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/location_end"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:clickable="false"
            android:focusable="false"
            android:gravity="center_vertical"
            android:hint="@string/route_2"
            android:paddingHorizontal="12dp"
            android:textColor="@color/black"
            android:textColorHint="@color/gray_dark"
            android:textSize="15sp" />

        <ImageButton
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@android:color/transparent"
            android:clickable="false"
            android:contentDescription="@string/location_picker"
            android:focusable="false"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/add_location" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_Cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/box_white_red"
            android:text="@string/cancel"
            android:textColor="@color/red"
            android:textSize="15sp"
            app:backgroundTint="@null"
            app:backgroundTintMode="@null"
            app:cornerRadius="5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/box_blue_dark"
            android:text="@string/confirm"
            android:textSize="15sp"
            app:backgroundTint="@null"
            app:backgroundTintMode="@null"
            app:cornerRadius="5dp" />

    </LinearLayout>

</LinearLayout>