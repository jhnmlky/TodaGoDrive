<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog">

    <LinearLayout
        android:id="@+id/layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/change_association"
            android:textColor="@color/blue_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/location_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            android:background="@drawable/input_bg"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/location"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center_vertical"
                android:hint="@string/location"
                android:paddingHorizontal="12dp"
                android:textColor="@color/black"
                android:textColorHint="@color/gray_dark"
                android:textSize="15sp" />

            <ImageButton
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@android:color/transparent"
                android:clickable="false"
                android:contentDescription="@string/location_picker"
                android:focusable="false"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/add_location" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginBottom="2dp"
            android:text="@string/association"
            android:textColor="@color/gray_dark"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/association"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/spinner"
            android:popupBackground="@drawable/spinner_view"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/id_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="3dp"
            android:background="@drawable/input_bg"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/card"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center_vertical"
                android:hint="@string/license"
                android:paddingHorizontal="12dp"
                android:textColor="@color/black"
                android:textColorHint="@color/gray_dark"
                android:textSize="15sp" />

            <ImageButton
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@android:color/transparent"
                android:clickable="false"
                android:contentDescription="@string/id_picker"
                android:focusable="false"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/upload" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/permit_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="3dp"
            android:background="@drawable/input_bg"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/permit"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center_vertical"
                android:hint="@string/permit"
                android:paddingHorizontal="12dp"
                android:textColor="@color/black"
                android:textColorHint="@color/gray_dark"
                android:textSize="15sp" />

            <ImageButton
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@android:color/transparent"
                android:clickable="false"
                android:contentDescription="@string/permit_picker"
                android:focusable="false"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/upload" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="5dp"
            android:layout_marginVertical="3dp"
            android:text="@string/note_documents_driver"
            android:textAlignment="center"
            android:textColor="@color/blue_dark"
            android:textSize="11sp"
            android:textStyle="italic" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/box_white_red"
                android:text="@string/cancel"
                android:textColor="@color/red"
                android:textSize="15sp"
                app:backgroundTint="@null"
                app:backgroundTintMode="@null"
                app:cornerRadius="5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_change"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/box_blue_dark"
                android:text="@string/change"
                android:textSize="15sp"
                app:backgroundTint="@null"
                app:backgroundTintMode="@null"
                app:cornerRadius="5dp" />

        </LinearLayout>

    </LinearLayout>

    <include
        android:id="@+id/loading"
        layout="@layout/progress_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignBottom="@+id/layout" />

</RelativeLayout>