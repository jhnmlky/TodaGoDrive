<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cv_history"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="5dp"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="3dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/history_date"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="5dp"
            android:textColor="@color/blue_dark"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_white_top"
            android:orientation="vertical"
            android:paddingHorizontal="15dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/history_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/blue_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/history_UID"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/history_driver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_white_bottom"
            android:orientation="vertical"
            android:paddingHorizontal="15dp"
            android:paddingTop="0dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/history_type_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignEnd="@id/history_destination_label"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:text="@string/type"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/history_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/history_type_label"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/history_passenger_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/history_type"
                android:layout_alignEnd="@id/history_destination_label"
                android:layout_alignParentStart="true"
                android:text="@string/passenger"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/history_passenger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/history_type"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/history_passenger_label"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/history_origin_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/history_passenger"
                android:layout_alignEnd="@id/history_destination_label"
                android:layout_alignParentStart="true"
                android:text="@string/origin"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/history_origin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/history_passenger"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/history_origin_label"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/history_destination_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/history_origin"
                android:layout_alignParentStart="true"
                android:paddingStart="0dp"
                android:paddingEnd="5dp"
                android:text="@string/destination"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/history_destination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/history_origin"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/history_destination_label"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/history_price_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/history_destination"
                android:layout_alignEnd="@id/history_destination_label"
                android:layout_alignParentStart="true"
                android:text="@string/price_"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/history_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/history_destination"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/history_price_label"
                android:textColor="@color/black"
                android:textSize="14sp" />

        </RelativeLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>